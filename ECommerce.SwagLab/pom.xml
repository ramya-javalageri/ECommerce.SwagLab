<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>BITM_CPG</groupId>
  <artifactId>ECommerce.SwagLab</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  
  <dependencies>
       
        <!-- Source: https://mvnrepository.com/artifact/org.seleniumhq.selenium/selenium-java -->
<dependency>
    <groupId>org.seleniumhq.selenium</groupId>
    <artifactId>selenium-java</artifactId>
    <version>4.46.0</version>
</dependency>

<!-- Source: https://mvnrepository.com/artifact/org.apache.poi/poi -->
<dependency>
    <groupId>org.apache.poi</groupId>
    <artifactId>poi</artifactId>
    <version>5.4.1</version>
</dependency>

<!-- Source: https://mvnrepository.com/artifact/org.apache.poi/poi-ooxml -->
<dependency>
    <groupId>org.apache.poi</groupId>
    <artifactId>poi-ooxml</artifactId>
    <version>5.4.1</version>
</dependency>

<!-- Source: https://mvnrepository.com/artifact/org.testng/testng -->
<dependency>
    <groupId>org.testng</groupId>
    <artifactId>testng</artifactId>
    <version>7.10.2</version>
</dependency>


    </dependencies>

      <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>

        <profile>
            <id>batch</id>
            <properties>
                <suiteXmlFile>testing/BatchExecution.xml</suiteXmlFile>
            </properties>
        </profile>

        <profile>
            <id>cart</id>
            <properties>
                <suiteXmlFile>testing/Cart.xml</suiteXmlFile>
            </properties>
        </profile>

        <profile>
            <id>checkout</id>
            <properties>
                <suiteXmlFile>testing/Checkout.xml</suiteXmlFile>
            </properties>
        </profile>
        
        <profile>
            <id>login</id>
            <properties>
                <suiteXmlFile>testing/Login.xml</suiteXmlFile>
            </properties>
        </profile>
        
        <profile>
            <id>product</id>
            <properties>
                <suiteXmlFile>testing/Product.xml</suiteXmlFile>
            </properties>
        </profile>
        
        <profile>
            <id>menu</id>
            <properties>
                <suiteXmlFile>testing/Menu.xml</suiteXmlFile>
            </properties>
        </profile>
        
        <profile>
            <id>functional</id>
            <properties>
                <suiteXmlFile>testing/Functional.xml</suiteXmlFile>
            </properties>
        </profile>
        
        <profile>
            <id>integration</id>
            <properties>
                <suiteXmlFile>testing/Integration.xml</suiteXmlFile>
            </properties>
        </profile>
        
        <profile>
            <id>smoke</id>
            <properties>
                <suiteXmlFile>testing/Smoke.xml</suiteXmlFile>
            </properties>
        </profile>

		<profile>
            <id>system</id>
            <properties>
                <suiteXmlFile>testing/System.xml</suiteXmlFile>
            </properties>
        </profile>
        
        <profile>
            <id>negative</id>
            <properties>
                <suiteXmlFile>testing/Negative.xml</suiteXmlFile>
            </properties>
        </profile>
        
        <profile>
            <id>parallel</id>
            <properties>
                <suiteXmlFile>testing/Parallel.xml</suiteXmlFile>
            </properties>
        </profile>
        
        <profile>
            <id>crossbrowser</id>
            <properties>
                <suiteXmlFile>testing/CrossBrowser.xml</suiteXmlFile>
            </properties>
        </profile>
        
        <profile>
            <id>regression</id>
            <properties>
                <suiteXmlFile>testing/Regression.xml</suiteXmlFile>
            </properties>
        </profile>
	
    </profiles>
</project>
