<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SwagLabs Parallel Suite" parallel="tests" thread-count="2">

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="ecommerce_swaglabs.login.LoginTest"/>
            <class name="ecommerce_swaglabs.product.ProductCartIntegrationTest"/>
            <class name="ecommerce_swaglabs.checkout.CheckoutTest"/>
		</classes>
    </test>
    
    <test name="Edge Tests"  >
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="ecommerce_swaglabs.login.LoginTest"/>
            <class name="ecommerce_swaglabs.product.ProductCartIntegrationTest"/>
            <class name="ecommerce_swaglabs.checkout.CheckoutTest"/>
		</classes>
    </test>
    


</suite>